# ── Claude OS — Environment Variables ────────────────────────────────────────
# Copy this file to .env.local on your VPS and fill in your values

# OpenAI API key — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# Model to use (gpt-4o-mini is fast + cheap, gpt-4o is smarter)
OPENAI_MODEL=gpt-4o-mini

# Optional: override base URL (leave as-is for standard OpenAI)
OPENAI_BASE_URL=https://api.openai.com/v1

# JWT secret — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-string

# One-time key to create your admin account via /api/auth/seed
SEED_KEY=pick-any-secret-word

# Optional: custom SQLite path (default: ./data/claude-os.db)
# DB_PATH=/var/lib/claude-os

# Optional: directory agents can read/write files to
# AGENT_FILES_DIR=/var/lib/claude-os/agent-files

# ── MCD (Marketing & Conversions Director) Connector Settings ─────────────────
# Set these after running mcd-deploy.sh on the VPS

# MCD Python environment (set by mcd-deploy.sh)
MCD_SCRIPTS_DIR=/root/agentic-os/mcd/scripts
MCD_VENV_PYTHON=/root/agentic-os/mcd/venv/bin/python3
MCD_GCHAT_SCRIPT=/root/agentic-os/mcd/bin/post_gchat.py

# Enable the MCD weekly report cron (Monday 07:30 America/Phoenix)
# Set to true once mcd-deploy.sh has been run and all MCD env vars are configured
MCD_WEEKLY_ENABLED=false

# GoHighLevel (GHL) — read-only PIT token
GHL_API_KEY=pit-...your-key-here...
GHL_LOCATION_ID=...your-location-id...

# Google service account key (all four Google connectors share one file)
GA4_SA_JSON=/root/agentic-os/mcd/secrets/google-sa.json
GSC_SA_JSON=/root/agentic-os/mcd/secrets/google-sa.json
GTM_SA_JSON=/root/agentic-os/mcd/secrets/google-sa.json
INITIATIVES_SA_JSON=/root/agentic-os/mcd/secrets/google-sa.json

# GA4 property IDs and event names
GA4_PROPERTY_ID=...main-property-id...
GA4_KEYWORD_HERO_PROPERTY_ID=...kh-property-id...
GA4_KH_KEYWORD_DIMENSION=customEvent:keywords
GA4_FORM_EVENT=ads_conversion_Submit_lead_form_1

# Google Search Console
GSC_SITE_URL=sc-domain:phxhomeremodeling.com

# Google Tag Manager
GTM_ACCOUNT_ID=...your-account-id...
GTM_CONTAINER_ID=...your-container-id...

# Jeremy's initiatives Google Doc
INITIATIVES_DOC_ID=...your-doc-id...

# Call feedback sheet (OpenAI Employee Call Analysis — same SA as Google connectors)
CALL_FEEDBACK_SHEET_ID=...your-sheet-id...
CALL_FEEDBACK_SA_JSON=/root/agentic-os/mcd/secrets/google-sa.json

# SEO Utils MCP — HTTP Streamable MCP on the Windows VPS
# URL: full path including /mcp  (portproxy must be set up: netsh interface portproxy add v4tov4
#        listenaddress=198.37.105.107 listenport=19515 connectaddress=127.0.0.1 connectport=19515)
# Token: Bearer token from SEO Utils dashboard → Settings → MCP
SEOUTILS_MCP_URL=http://198.37.105.107:19515/mcp
SEOUTILS_MCP_TOKEN=...your-bearer-token-here...

# Google Chat webhook — MCD Reports private space
MCD_GCHAT_WEBHOOK=https://chat.googleapis.com/v1/spaces/...

# N8N email webhook — receives { subject, html, text, report_type, period_start, period_end, report_id }
# Reports auto-send after generation (cron or Run Now) and can be manually re-sent via "Send Email" button
MCD_N8N_EMAIL_WEBHOOK=https://n8n.phoenixhomeremodeling.net/webhook/1d8d1fbe-3a3f-4025-941d-fb4266af6085

# N8N webhook for Email Health Report send button
EMAIL_HEALTH_N8N_WEBHOOK=https://n8n.phoenixhomeremodeling.net/webhook/skEGe5kxbFz2fa7E
